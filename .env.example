# ═══════════════════════════════════════════════════════════════
# AwarQuest — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ── Database (PostgreSQL) ─────────────────────────────────────
# Required. Use postgresql:// scheme.
# Local (docker-compose): provided automatically.
# Railway: auto-provided when you add the PostgreSQL add-on.
DATABASE_URL=postgresql://komalmagar17:l%40kshaYbAB3u@localhost:5432/sihBackend
DB_SSL=false

# ── JWT Secrets ───────────────────────────────────────────────
# REQUIRED — minimum 48 characters each, must be DIFFERENT from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=super_secure_jwt_access_secret_key_at_least_48_chars_long_here
JWT_REFRESH_SECRET=super_secure_jwt_refresh_secret_key_at_least_48_chars_long_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Include your Vercel domain for production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5001,https://awarquest.vercel.app

# ── Cookies / Proxy ───────────────────────────────────────────
COOKIE_DOMAIN=
TRUST_PROXY=1

# ── Database Auto-Sync ────────────────────────────────────────
# Set to true to auto-run migrations on startup.
AUTO_SYNC=true

# ── Guest Play ────────────────────────────────────────────────
# Allow anonymous guest mode (no registration required).
# Works with mock data on static hosting (Vercel).
GUEST_PLAY_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# SMTP — Email / OTP Verification
# ═══════════════════════════════════════════════════════════════
# Required for OTP-based user registration (email verification).
# Without SMTP, OTP codes are shown on-screen in development mode only.
#
# ── Option A: Gmail (free, recommended for testing) ───────────
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to App Passwords → Generate one for "Mail"
# 4. Use the 16-character app password below (NOT your Gmail password)
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=your-email@gmail.com
#
# ── Option B: SendGrid (free tier: 100 emails/day) ───────────
# 1. Sign up at https://sendgrid.com
# 2. Go to Settings → API Keys → Create API Key (Full Access)
# 3. Use the API key as SMTP_PASS and "apikey" as SMTP_USER
#
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourdomain.com
#
# ── Option C: No SMTP (dev mode only) ────────────────────────
# Leave these empty. OTP codes will display on-screen for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# ═══════════════════════════════════════════════════════════════
# AI Service (optional)
# ═══════════════════════════════════════════════════════════════
AI_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=secret_internal_ai_token_change_in_production_987654321
AI_REQUEST_TIMEOUT_MS=3500

# Google Gemini API Key (for AI chat responses, optional)
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
