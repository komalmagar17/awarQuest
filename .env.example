# =========================================================================
# ROOT ENVIRONMENT CONFIGURATION (For Docker Compose)
# =========================================================================

# --- AI Configuration ---
# Your Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Inter-Service Security ---
# Shared secret for internal communication between Node.js and Python.
# MUST be at least 32 characters long.
AI_SERVICE_TOKEN=secret_internal_ai_token_change_in_production_987654321

# --- Database Credentials ---
POSTGRES_USER=lifeskills
POSTGRES_PASSWORD=securepassword123
POSTGRES_DB=life_skills_adventure
