NODE_ENV=development
PORT=5000
TRUST_PROXY=1
LOG_LEVEL=info

DATABASE_URL=postgresql://lifeskills:securepassword123@postgres:5432/life_skills_adventure
DB_SSL=false
AUTO_SYNC=false


JWT_ACCESS_SECRET=replace-with-a-random-64-character-secret-key-at-least-48-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-64-character-secret-key-at-least-48-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_DOMAIN=

AI_ENABLED=true
# Use 'ai-service' as host when running in Docker, 'localhost' for local dev.
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TOKEN=secret_internal_ai_token_change_in_production_987654321
AI_REQUEST_TIMEOUT_MS=3500

# Email / OTP (optional — without SMTP, OTP is shown in dev mode on screen + server logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@lifeskills.local
