# =========================================================================
# AI MICROSERVICE CONFIGURATION (Python / FastAPI)
# =========================================================================

# --- Gemini API ---
# Your Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Inter-Service Security ---
# MUST exactly match the AI_SERVICE_TOKEN in the backend .env.
AI_SERVICE_TOKEN=secret_internal_ai_token_change_in_production_987654321

# --- Server Settings ---
AI_PORT=8001
AI_LOG_LEVEL=INFO
